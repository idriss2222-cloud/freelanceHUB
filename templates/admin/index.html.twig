{% extends 'base.html.twig' %}

{% block title %}Administration · FreelanceHUB{% endblock %}

{% block body %}
    <div class="form-layout">
        <header class="page-heading">
            <p class="eyebrow">Espace sécurisé</p>
            <h1>Administration</h1>
            <p class="text-secondary">Vous êtes connecté avec un compte administrateur.</p>
        </header>

        <section class="card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h2 class="h5">Bonjour, {{ app.user.fullName }}</h2>
                <p class="text-secondary mb-4">Votre accès administrateur est actif.</p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" href="{{ path('app_project_index') }}">Consulter les projets</a>
                    <a class="btn btn-outline-primary" href="{{ path('app_profile') }}">Mon profil</a>
                </div>
            </div>
        </section>
    </div>
{% endblock %}
