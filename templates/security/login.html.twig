{% extends 'base.html.twig' %}

{% block title %}Connexion · FreelanceHUB{% endblock %}

{% block body %}
    <div class="auth-layout">
        <section class="auth-intro">
            <p class="eyebrow">Bienvenue sur FreelanceHUB</p>
            <h1>Les bonnes collaborations commencent ici.</h1>
            <p>Connectez-vous pour retrouver votre profil et vos compétences.</p>
        </section>

        <section class="card auth-card border-0 shadow-sm">
            <div class="card-body p-4 p-md-5">
                <h2 class="h3 mb-2">Connexion</h2>
                <p class="text-secondary mb-4">Accédez à votre espace personnel.</p>

                {% if has_error %}
                    <div class="alert alert-danger" role="alert">Adresse courriel ou mot de passe invalide.</div>
                {% endif %}

                <form method="post" action="{{ path('app_login') }}">
                    <div class="mb-3">
                        <label class="form-label" for="email">Adresse courriel</label>
                        <input class="form-control form-control-lg" type="email" id="email" name="email"
                               value="{{ last_email }}" autocomplete="email" required autofocus>
                    </div>
                    <div class="mb-4">
                        <label class="form-label" for="password">Mot de passe</label>
                        <input class="form-control form-control-lg" type="password" id="password" name="password"
                               autocomplete="current-password" required>
                    </div>
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                    <button class="btn btn-primary btn-lg w-100" type="submit">Se connecter</button>
                </form>

                <p class="text-secondary text-center mt-4 mb-0">Pas encore de compte ?
                    <a href="{{ path('app_register') }}">Inscrivez-vous</a>
                </p>
            </div>
        </section>
    </div>
{% endblock %}
