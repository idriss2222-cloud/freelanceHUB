<!doctype html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#102a43">
    <title>{% block title %}FreelanceHUB{% endblock %}</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet"
          integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
          crossorigin="anonymous">
    <link rel="stylesheet" href="/styles/app.css">
</head>
<body>
<nav class="navbar navbar-expand-lg navbar-dark site-nav">
    <div class="container">
        <a class="navbar-brand fw-bold" href="{{ path('app_home') }}">Freelance<span>HUB</span></a>
        <div class="d-flex align-items-center gap-2 ms-auto">
            {% if app.user %}
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_project_index') }}">Projets</a>
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_freelancer_index') }}">Freelancers</a>
                <span class="navbar-text d-none d-sm-inline">{{ app.user.fullName }}</span>
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_profile') }}">Mon profil</a>
                <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button class="btn btn-light btn-sm" type="submit">Déconnexion</button>
                </form>
            {% else %}
                <a class="btn btn-outline-light btn-sm" href="{{ path('app_login') }}">Connexion</a>
                <a class="btn btn-light btn-sm" href="{{ path('app_register') }}">Créer un compte</a>
            {% endif %}
        </div>
    </div>
</nav>

<main class="container page-shell">
    {% for label, messages in app.flashes %}
        {% for message in messages %}
            <div class="alert alert-{{ label == 'error' ? 'danger' : label }} alert-dismissible fade show" role="alert">
                {{ message }}
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
            </div>
        {% endfor %}
    {% endfor %}

    {% block body %}{% endblock %}
</main>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-FKyoEForCGlyvwx9Hj09JcYn3nv7wiPVlz7YYwJrWVcXK/BmnVDxM+D2scQbITxI"
        crossorigin="anonymous"></script>
</body>
</html>
